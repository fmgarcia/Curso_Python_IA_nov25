# ============================================
# .gitignore - Sistema de Detección de Tumores
# ============================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Entornos virtuales
venv/
.venv/
env/
.env/
ENV/

# ---- Node.js ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Build ----
frontend/build/
*.min.js
*.min.css

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# ---- OS ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ---- Logs ----
*.log
logs/

# ---- Archivos locales de entorno ----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ---- Jupyter Notebooks ----
.ipynb_checkpoints/
*.ipynb

# ---- Archivos temporales ----
*.tmp
*.temp
*.bak

# ---- Certificados SSL (no subir claves privadas) ----
certbot/
*.pem
*.key

# ---- Docker (archivos generados localmente) ----
docker-compose.override.yml

# ---- Tests ----
.coverage
htmlcov/
.pytest_cache/
coverage/

# ---- Pesos de modelos (OPCIONAL) ----
# Descomentar si no quieres subir los modelos entrenados
# backend/weights/*.joblib
# backend/weights/*_accuracy.json

# ---- Datasets personalizados ----
backend/uploads/*.csv
!backend/uploads/.gitkeep
